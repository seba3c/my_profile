  "narrative": {
    "northStar": "The Working Engineer's Terminal",
    "overview": "A modern terminal gives this portfolio its code-first character: ink surfaces, green actions, fine rules and monospace headings. Normal navigation and readable prose make the work easy to inspect without requiring visitors to understand terminal commands.\n\nProject text and professional identity lead; small real project screenshots provide secondary visual evidence. The profile hero contains no project screenshot. Preserve the owner's identity and a small portrait; use actual work rather than invented product imagery. Amber emphasizes the supporting hero focus line alongside green actions.\n\nThis document extracts the implemented source, including the terminal overrides in `src/styles/global.css`. Browser visual QA was unavailable because automatic approval review reached its usage limit. These are source-derived decisions, not a claim of rendered visual validation.",
    "keyCharacteristics": [
      "Code-first identity with readable Inter body copy.",
      "Real project imagery and restrained portrait treatment.",
      "Ink surfaces, green actions and fine dividing rules.",
      "Visible final content before progressive enhancement.",
      "Searchable global commands alongside ordinary navigation."
    ],
    "rules": [
      {
        "name": "The Action Green Rule",
        "body": "Reserve filled green surfaces for actionable emphasis; keep project imagery secondary to titles, descriptions and actions.",
        "section": "colors"
      },
      {
        "name": "The Visible Content Rule",
        "body": "Final page content is visible before JavaScript runs; never make essential content depend on a reveal animation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use real project screenshots and preserve accurate professional identity and project authorship.",
      "**Do** keep headings monospace and long reading copy in Inter.",
      "**Do** retain ordinary navigation, contact, CV and bilingual blog access alongside commands.",
      "**Do** show final content before enhancement and honor reduced motion immediately.",
      "**Do** keep narrow archive entries readable with their field values visible."
    ],
    "donts": [
      "**Don't** substitute generated project mockups for real evidence.",
      "**Don't** turn the terminal metaphor into a prerequisite for navigation.",
      "**Don't** use decorative reveal effects that hide content before JavaScript.",
      "**Don't** claim browser visual validation from source inspection alone."
    ]
  }
}
