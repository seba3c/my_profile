---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import TechStack from '../components/TechStack.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import FeaturedEvents from '../components/FeaturedEvents.astro';
import Footer from '../components/Footer.astro';
import Experience from '../components/Experience.astro';
import Academic from '../components/Academic.astro';
import Certifications from '../components/Certifications.astro';
import { site } from '../../data/site';

const projects = site.featuredProjects;
const events = site.featuredEvents;
---

<Layout title={site.meta.title} description={site.meta.description}>
  <About />
  <TechStack />
  <FeaturedProjects projects={projects} />
  <!-- <FeaturedEvents events={events} /> -->
  <Experience />
  <Certifications />
  <!-- <Academic /> -->
  <Footer />
</Layout>
