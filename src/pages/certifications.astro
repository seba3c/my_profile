---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const title = `${site.certificationArchivePage.title} | ${site.hero.name}`;
const description = site.certificationArchivePage.description;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeHref = `${base}#certifications`;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a
      href={homeHref}
      class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light"
      data-astro-prefetch
    >
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      {site.hero.name}
    </a>
  </p>

  <h1 class="mb-8 text-4xl font-bold tracking-tight text-white sm:text-4xl">{site.certificationArchivePage.title}</h1>

  <p class="mb-10 max-w-prose body-copy">
    {site.certificationArchivePage.intro}
  </p>

  <div class="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full table-fixed border-spacing-0 text-left text-sm">
        <thead class="text-slate">
          <tr>
            <th scope="col" class="hidden md:table-cell w-16 whitespace-nowrap px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Date
            </th>
            <th scope="col" class="w-7/12 md:w-5/12 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Certification
            </th>
            <th scope="col" class="hidden md:table-cell w-0 md:w-40 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Issuer
            </th>
            <th scope="col" class="w-24 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              
            </th>
          </tr>
        </thead>
        <tbody>
          {
            site.certificationArchive.map((row) => (
              <tr>
                <td class="hidden md:table-cell whitespace-nowrap px-4 py-4 font-mono text-slate">{row.date}</td>
                <td class="px-4 py-4">
                  <div class="text-slate">{row.name}</div>
                </td>
                <td class="hidden md:table-cell px-4 py-4 text-slate">{row.issuer}</td>
                <td class="px-4 py-4">
                  {row.credentialLink ? (
                    <a
                      href={row.credentialLink}
                      target="_blank"
                      rel="noreferrer"
                      class="pill-link"
                    >
                      Show credential
                      <Icon name="ph:arrow-square-out" class="h-3 w-3" />
                    </a>
                  ) : (
                    <span class="text-sm text-slate-lightest">-</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</ArchiveLayout>