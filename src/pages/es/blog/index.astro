---
import BlogArchiveLayout from '../../../layouts/BlogArchiveLayout.astro';
import BlogArchiveList from '../../../components/BlogArchiveList.astro';
import { getPostsByLocale } from '../../../lib/blog';
import { blogStrings } from '../../../lib/blog-i18n';
import { site } from '@data/site';

const locale = 'es';
const posts = await getPostsByLocale(locale);
const strings = blogStrings[locale];
const title = `${strings.archiveTitle} | ${site.hero.name}`;
---

<BlogArchiveLayout locale={locale} title={title} description={strings.archiveIntro}>
  <h1 class="mb-8 text-4xl font-bold tracking-tight text-white sm:text-4xl">{strings.archiveTitle}</h1>
  <p class="mb-10 max-w-prose body-copy">{strings.archiveIntro}</p>
  <BlogArchiveList posts={posts} locale={locale} />
</BlogArchiveLayout>
