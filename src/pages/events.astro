---
import ArchiveLayout from '../layouts/ArchiveLayout.astro';
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const title = `${site.eventArchivePage.title} | ${site.hero.name}`;
const description = site.eventArchivePage.description;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeHref = `${base}#featured-events`;
---

<ArchiveLayout title={title} description={description}>
  <p class="mb-8">
    <a
      href={homeHref}
      class="group flex items-center gap-2 text-sm text-accent transition hover:text-slate-light"
      data-astro-prefetch
    >
      <Icon name="ph:arrow-left" class="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      {site.hero.name}
    </a>
  </p>

  <h1 class="mb-8 text-4xl font-bold tracking-tight text-white sm:text-4xl">{site.eventArchivePage.title}</h1>

  <p class="mb-10 max-w-prose body-copy">
    {site.eventArchivePage.intro}
  </p>

  <div class="overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full table-fixed border-spacing-0 text-left text-sm">
        <thead class="text-slate">
          <tr>
            <th scope="col" class="w-16 whitespace-nowrap px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Date
            </th>
            <th scope="col" class="w-6/12 md:w-5/12 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Event
            </th>
            <th scope="col" class="hidden md:table-cell w-0 md:w-40 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Location
            </th>
            <th scope="col" class="hidden md:table-cell w-0 md:w-24 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              Role
            </th>
            <th scope="col" class="w-32 px-4 py-4 text-xs font-medium uppercase tracking-[0.25em]">
              
            </th>
          </tr>
        </thead>
        <tbody>
          {
            site.eventArchive.map((row) => (
              <tr>
                <td class="whitespace-nowrap px-4 py-4 font-mono text-slate">{row.date}</td>
                <td class="px-4 py-4">
                  {row.eventLink ? (
                    <a
                      href={row.eventLink}
                      target="_blank"
                      rel="noreferrer"
                      class="inline-flex items-center gap-1.5 text-slate transition hover:text-accent"
                    >
                      {row.event}
                      <Icon name="ph:arrow-square-out" class="h-3 w-3" />
                    </a>
                  ) : (
                    <div class="text-slate">{row.event}</div>
                  )}
                  {row.description && (
                    <div class="mt-1 text-xs text-slate-light">{row.description}</div>
                  )}
                </td>
                <td class="hidden md:table-cell px-4 py-4 text-slate">{row.location}</td>
                <td class="hidden md:table-cell px-4 py-4 text-slate">{row.role}</td>
                <td class="px-4 py-4">
                  {row.activityLink ? (
                    <a
                      href={row.activityLink}
                      target="_blank"
                      rel="noreferrer"
                      class="pill-link"
                    >
                      Activity
                      <Icon name="ph:arrow-square-out" class="h-3 w-3" />
                    </a>
                  ) : (
                    <span class="text-sm text-slate-lightest">-</span>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</ArchiveLayout>
