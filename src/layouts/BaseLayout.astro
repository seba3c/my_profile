---
import '../styles/global.css';
import { site } from '@data/site';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../config.ts';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  alternates?: { hreflang: string; href: string }[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const {
  title = site.meta.title,
  description = site.meta.description,
  lang = 'en',
  canonicalUrl,
  alternates = [],
  noindex = false,
  ogType = 'website',
  structuredData,
} = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).href;
const profileImage = new URL(site.hero.avatarSrc, Astro.site).href;

const baseTheme = SITE_CONFIG.baseTheme;
const defaultTheme = `${baseTheme}-dark`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={profileImage} />
    <meta property="og:image:alt" content={site.hero.avatarAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={profileImage} />
    {structuredData && <JsonLd data={structuredData} />}
    <ClientRouter />

    <!-- THEME INITIALIZATION SCRIPT -->
    <script is:inline define:vars={{ baseTheme, defaultTheme }}>
      function applyTheme() {
        const savedTheme = localStorage.getItem('theme');

        if (savedTheme && savedTheme.startsWith(baseTheme)) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          document.documentElement.setAttribute('data-theme', defaultTheme);
          localStorage.setItem('theme', defaultTheme);
        }
      }

      // Apply theme on initial load
      applyTheme();

      // Re-apply theme after navigation (for view transitions)
      document.addEventListener('astro:page-load', applyTheme);
    </script>

    <!-- BLOG NAV LOCALE SCRIPT
         The "Blog" nav link's target locale is picked client-side (this is a
         fully static site, so there's no Accept-Language header to read on
         the server): a stored preference wins, otherwise the browser's own
         language decides. This only ever rewrites the nav link's href — a
         directly-loaded blog URL is never redirected. -->
    <script is:inline>
      function resolveBlogLocale() {
        const stored = localStorage.getItem('blog-locale');
        if (stored === 'en' || stored === 'es') return stored;
        return navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
      }

      function rewriteBlogNavLinks() {
        const locale = resolveBlogLocale();
        document.querySelectorAll('[data-blog-nav-link]').forEach((link) => {
          link.setAttribute('href', locale === 'es' ? '/es/blog' : '/blog');
        });
      }

      rewriteBlogNavLinks();
      document.addEventListener('astro:page-load', rewriteBlogNavLinks);
    </script>

    <!-- Global CSS has `scroll-behavior: smooth` (see global.css) so that
         in-page nav-link clicks and hash landings animate. But on browser
         back/forward navigation, Astro's ClientRouter restores the previous
         scroll position with a plain `scrollTo(x, y)` that also inherits
         that smooth behavior, animating the jump back to wherever the user
         had scrolled to instead of restoring instantly. (Forcing this off
         via document.documentElement.style doesn't work here — Astro's swap
         copies the new document's root attributes over the old ones,
         wiping any inline style we set beforehand.) On long pages (mobile's
         stacked single-column layout in particular) that animation takes
         long enough for the scroll-spy to latch onto whatever section it
         passes through on the way, leaving the wrong nav item highlighted.
         Re-issue the restore ourselves as an instant jump right after. -->
    <script is:inline>
      let pendingTraverseRestore = false;
      document.addEventListener('astro:before-swap', (e) => {
        pendingTraverseRestore = e.navigationType === 'traverse';
      });
      document.addEventListener('astro:after-swap', () => {
        if (pendingTraverseRestore && history.state) {
          window.scrollTo({ left: history.state.scrollX, top: history.state.scrollY, behavior: 'instant' });
        }
        pendingTraverseRestore = false;
      });
    </script>

    <!-- The body's pageFadeIn keyframe animation (see global.css) uses
         `animation-fill-mode: forwards`, which keeps a `transform` on <body>
         after the animation ends (translateY(0) still counts as a transform,
         not `none`). A transformed ancestor becomes the containing block for
         `position: fixed` descendants, which would otherwise stop tracking
         the viewport. Clear it once the animation finishes. -->
    <script is:inline>
      document.addEventListener('animationend', (e) => {
        if (e.target === document.body && e.animationName === 'pageFadeIn') {
          document.body.style.animation = 'none';
          document.body.style.opacity = '1';
          document.body.style.transform = 'none';
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-background text-maintext antialiased selection:bg-accent/30 selection:text-background">
    <slot />
  </body>
</html>
