---
import '../styles/global.css';
import { site } from '@data/site';
import { ClientRouter } from 'astro:transitions';
import { SITE_CONFIG } from '../config.ts';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  canonicalUrl?: string;
  alternates?: { hreflang: string; href: string }[];
}

const {
  title = site.meta.title,
  description = site.meta.description,
  lang = 'en',
  canonicalUrl,
  alternates = [],
} = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site.url).href;

const baseTheme = SITE_CONFIG.baseTheme;
const defaultTheme = `${baseTheme}-dark`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiJ-Ek-_EeA.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="https://fonts.gstatic.com/s/spacegrotesk/v15/V8mQoQDjQSkFtoMM3T6r8E7mF71Q.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbI2oqRg1oM3QBjjcaDkOr4fQ.woff2" as="font" type="font/woff2" crossorigin>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <ClientRouter />

    <!-- THEME INITIALIZATION SCRIPT -->
    <script is:inline define:vars={{ baseTheme, defaultTheme }}>
      function applyTheme() {
        const savedTheme = localStorage.getItem('theme');

        if (savedTheme && savedTheme.startsWith(baseTheme)) {
          document.documentElement.setAttribute('data-theme', savedTheme);
        } else {
          document.documentElement.setAttribute('data-theme', defaultTheme);
          localStorage.setItem('theme', defaultTheme);
        }
      }

      // Apply theme on initial load
      applyTheme();

      // Re-apply theme after navigation (for view transitions)
      document.addEventListener('astro:page-load', applyTheme);
    </script>

    <!-- BLOG NAV LOCALE SCRIPT
         The "Blog" nav link's target locale is picked client-side (this is a
         fully static site, so there's no Accept-Language header to read on
         the server): a stored preference wins, otherwise the browser's own
         language decides. This only ever rewrites the nav link's href — a
         directly-loaded blog URL is never redirected. -->
    <script is:inline>
      function resolveBlogLocale() {
        const stored = localStorage.getItem('blog-locale');
        if (stored === 'en' || stored === 'es') return stored;
        return navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
      }

      function rewriteBlogNavLinks() {
        const locale = resolveBlogLocale();
        document.querySelectorAll('[data-blog-nav-link]').forEach((link) => {
          link.setAttribute('href', locale === 'es' ? '/es/blog' : '/blog');
        });
      }

      rewriteBlogNavLinks();
      document.addEventListener('astro:page-load', rewriteBlogNavLinks);
    </script>

    <!-- The body's pageFadeIn keyframe animation (see global.css) uses
         `animation-fill-mode: forwards`, which keeps a `transform` on <body>
         after the animation ends (translateY(0) still counts as a transform,
         not `none`). A transformed ancestor becomes the containing block for
         `position: fixed` descendants, which would otherwise stop tracking
         the viewport. Clear it once the animation finishes. -->
    <script is:inline>
      document.addEventListener('animationend', (e) => {
        if (e.target === document.body && e.animationName === 'pageFadeIn') {
          document.body.style.animation = 'none';
          document.body.style.opacity = '1';
          document.body.style.transform = 'none';
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-background text-maintext antialiased selection:bg-accent/30 selection:text-background">
    <slot />
  </body>
</html>
