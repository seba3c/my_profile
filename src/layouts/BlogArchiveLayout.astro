---
import Breadcrumb from '../components/Breadcrumb.astro';
import ArchiveLayout from './ArchiveLayout.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import BlogMiniHeader from '../components/BlogMiniHeader.astro';
import { resolveNavHref } from '../lib/nav';
import { blogStrings, type BlogLocale } from '../lib/blog-i18n';

interface Props {
  locale: BlogLocale;
  title: string;
  description: string;
}

const { locale, title, description } = Astro.props;
const strings = blogStrings[locale];

const enUrl = new URL(resolveNavHref('/blog/'), Astro.site).href;
const esUrl = new URL(resolveNavHref('/es/blog/'), Astro.site).href;
const alternates = [
  { hreflang: 'en', href: enUrl },
  { hreflang: 'es', href: esUrl },
  { hreflang: 'x-default', href: enUrl },
];
---

<ArchiveLayout title={title} description={description} lang={locale} alternates={alternates} showBreadcrumb={false}>
  <div class="blog-toolbar mb-8">
    <Breadcrumb label={strings.breadcrumbLabel} items={[
      { label: '~', href: resolveNavHref('#latest-writing'), accessibleLabel: strings.backToWriting },
      { label: 'blog' },
    ]} />
    <LanguageSwitcher locale={locale} enHref={resolveNavHref('/blog')} esHref={resolveNavHref('/es/blog')} />
  </div>
  <BlogMiniHeader />
  <h1 class="section-heading">{strings.archiveTitle}</h1>
  <slot />
</ArchiveLayout>
