---
import BaseLayout from './BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import MobileHeader from '../components/MobileHeader.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div
    class="mx-auto flex min-h-screen max-w-6xl flex-col lg:flex-row lg:gap-6 lg:px-12 xl:max-w-7xl xl:gap-0"
  >
    <SideNav />
    <main
      id="main"
      class="relative flex min-w-0 flex-1 flex-col px-4 pb-16 pt-12 sm:px-6 md:px-8 lg:py-15 lg:pl-4 lg:pr-0"
    >
      <div class="mb-4 flex justify-end lg:absolute lg:right-8 lg:top-8 lg:z-10 xl:right-12">
        <MobileHeader />
      </div>
      <slot />
    </main>
  </div>
  <script is:inline>
    // Scroll-reveal animation for cards with class "scroll-stat"
    (function () {
      function revealCards() {
        const cards = document.querySelectorAll('.scroll-stat');

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = Array.from(cards).indexOf(entry.target);
              setTimeout(() => {
                entry.target.classList.add('reveal');
              }, (index % 3) * 150);

              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15,
          rootMargin: '0px 0px -10px 0px'
        });

        cards.forEach(card => observer.observe(card));
      }

      revealCards();
      document.addEventListener('astro:after-swap', revealCards);
    })();
  </script>
  <script is:inline>
    (function () {
      let scrollHandler = null;

      function initScrollSpy() {
        // Clean up previous listener to avoid duplicates on view transitions
        if (scrollHandler) {
          window.removeEventListener('scroll', scrollHandler);
        }

        // Re-query DOM so we always operate on the current page's elements
        const links = Array.from(document.querySelectorAll('[data-section-link]'));
        const sections = ['about', 'tech-stack', 'featured-projects', 'featured-events', 'experiences', 'academic', 'certifications']
          .map((id) => document.getElementById(id))
          .filter(Boolean);

        if (!links.length || !sections.length) return;

        const setActive = (id) => {
          links.forEach((link) => {
            const href = link.getAttribute('href') || '';
            const isActive = href.endsWith('#' + id);
            link.classList.toggle('nav-link-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        };

        const updateActive = () => {
          const scrolledToBottom =
            window.innerHeight + window.scrollY >= document.body.scrollHeight - 10;

          if (scrolledToBottom) {
            setActive(sections[sections.length - 1].id);
            return;
          }

          if (window.scrollY < 50) {
            setActive(sections[0].id);
            return;
          }

          const active = [...sections]
            .reverse()
            .find((s) => s.getBoundingClientRect().top <= window.innerHeight * 0.15);

          if (active) setActive(active.id);
          else setActive(sections[0].id);
        };

        let ticking = false;
        scrollHandler = () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              updateActive();
              ticking = false;
            });
            ticking = true;
          }
        };

        window.addEventListener('scroll', scrollHandler, { passive: true });

        // Small delay to allow hash-scroll to settle before calculating active section
        setTimeout(updateActive, 50);
      }

      // Initialize on first load
      initScrollSpy();

      // Re-initialize after every view transition (Astro's ClientRouter)
      document.addEventListener('astro:page-load', initScrollSpy);
    })();
  </script>
</BaseLayout>
