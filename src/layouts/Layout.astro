---
import BaseLayout from './BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import MobileHeader from '../components/MobileHeader.astro';
import MobileNav from '../components/MobileNav.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div
    class="mx-auto flex min-h-screen max-w-6xl flex-col lg:flex-row lg:gap-6 lg:px-12 xl:max-w-7xl xl:gap-0"
  >
    <SideNav />
    <MobileNav />
    <main
      id="main"
      class="relative flex min-w-0 flex-1 flex-col px-4 pb-16 pt-12 sm:px-6 md:px-8 lg:py-15 lg:pl-4 lg:pr-0"
    >
      <div class="mb-4 flex justify-end lg:absolute lg:right-8 lg:top-8 lg:z-10 xl:right-12">
        <MobileHeader />
      </div>
      <slot />
    </main>
  </div>
  <script is:inline>
    // Scroll-reveal animation for cards with class "scroll-stat"
    (function () {
      function revealCards() {
        const cards = document.querySelectorAll('.scroll-stat');

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const index = Array.from(cards).indexOf(entry.target);
              setTimeout(() => {
                entry.target.classList.add('reveal');
              }, (index % 3) * 150);

              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15,
          rootMargin: '0px 0px -10px 0px'
        });

        cards.forEach(card => observer.observe(card));
      }

      revealCards();
      document.addEventListener('astro:after-swap', revealCards);
    })();
  </script>
  <script is:inline>
    (function () {
      let scrollHandler = null;

      function initScrollSpy() {
        // Clean up previous listener to avoid duplicates on view transitions
        if (scrollHandler) {
          window.removeEventListener('scroll', scrollHandler);
        }

        // Re-query DOM so we always operate on the current page's elements
        const links = Array.from(document.querySelectorAll('[data-section-link]'));
        const sections = ['about', 
                          'tech-stack', 
                          'featured-projects', 
                          'featured-events', 
                          'experiences', 
                          'certifications', 
                          'academic'
                          ]
          .map((id) => document.getElementById(id))
          .filter(Boolean);

        if (!links.length || !sections.length) return;

        const setActive = (id) => {
          links.forEach((link) => {
            const href = link.getAttribute('href') || '';
            const isActive = href.endsWith('#' + id);
            link.classList.toggle('nav-link-active', isActive);
            if (isActive) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        };

        const computeActiveId = () => {
          const scrolledToBottom =
            window.innerHeight + window.scrollY >= document.body.scrollHeight - 10;

          if (scrolledToBottom) return sections[sections.length - 1].id;
          if (window.scrollY < 50) return sections[0].id;

          const active = [...sections]
            .reverse()
            .find((s) => s.getBoundingClientRect().top <= window.innerHeight * 0.15);

          return active ? active.id : sections[0].id;
        };

        const updateActive = () => setActive(computeActiveId());

        // Landing here via a link to a specific section (e.g. the "back to
        // home" link on the archive pages) triggers the browser's own
        // smooth-scroll to that anchor, which can take a while (long page,
        // slow device). While that scroll is still in flight, keep forcing
        // the intended target as active instead of following whatever
        // sections the animation happens to pass through on the way — that
        // avoids depending on guessing how long the scroll will take. Once
        // the normal scroll-position calculation agrees with that target on
        // its own, hand off to it for ordinary live tracking.
        const hashId = location.hash.replace('#', '');
        const hashSection = sections.find((s) => s.id === hashId);
        let settling = Boolean(hashSection);

        if (hashSection) {
          setActive(hashId);
          // Safety net in case the target is never actually reached (e.g.
          // the scroll gets interrupted) — re-sync from actual scroll
          // position rather than leaving the display stuck.
          setTimeout(() => {
            if (settling) {
              settling = false;
              updateActive();
            }
          }, 2000);
        }

        let ticking = false;
        scrollHandler = () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              if (settling) {
                if (computeActiveId() === hashId) {
                  settling = false;
                } else {
                  setActive(hashId);
                }
              } else {
                updateActive();
              }
              ticking = false;
            });
            ticking = true;
          }
        };

        window.addEventListener('scroll', scrollHandler, { passive: true });

        // Small delay to allow hash-scroll to settle before calculating active section
        setTimeout(() => {
          if (!settling) updateActive();
        }, 50);
      }

      // Initialize on first load
      initScrollSpy();

      // Re-initialize after every view transition (Astro's ClientRouter)
      document.addEventListener('astro:page-load', initScrollSpy);
    })();
  </script>
</BaseLayout>
