---
import { blogStrings } from '../lib/blog-i18n';

interface Props {
  locale: 'en' | 'es';
  /** Absolute pathname for the English version of this exact page, if it exists. */
  enHref?: string;
  /** Absolute pathname for the Spanish version of this exact page, if it exists. */
  esHref?: string;
}

const { locale, enHref, esHref } = Astro.props;
const strings = blogStrings[locale];
const options = [{ code: 'en', href: enHref }, { code: 'es', href: esHref }] as const;
---

<nav class="language-switcher" aria-label={strings.languageLabel}>
  <span aria-hidden="true">lang:</span>
  {options.map(({ code, href }, index) => <>
    {index > 0 && <span class="language-separator" aria-hidden="true">/</span>}
    {locale === code ? (
      <span class="language-option language-active" aria-current="true" lang={code}>{code}</span>
    ) : href ? (
      <a class="language-option" href={href} lang={code} hreflang={code} aria-label={strings.switchLanguage[code]} data-lang-switch={code}>{code}</a>
    ) : (
      <span class="language-option language-unavailable" aria-disabled="true" title={strings.unavailableLanguage[code]} aria-label={strings.unavailableLanguage[code]}>{code}</span>
    )}
  </>)}
</nav>

<style>
  .language-switcher { display:flex; align-items:center; flex-shrink:0; font:13px/1.5 var(--font-heading); color:var(--color-subtext); }
  .language-option { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; }
  .language-active { color:var(--color-accent); }
  a.language-option:hover { color:var(--color-accent); text-decoration:underline; }
  .language-unavailable { color:var(--color-subtext); text-decoration:line-through; cursor:not-allowed; }
  .language-separator { color:var(--color-subtext); }
</style>

<script is:inline>
  (function () {
    function initLanguageSwitcher() {
      document.querySelectorAll('[data-lang-switch]').forEach((link) => {
        if (link.dataset.wired) return;
        link.dataset.wired = 'true';
        link.addEventListener('click', () => {
          try { localStorage.setItem('blog-locale', link.getAttribute('data-lang-switch')); } catch { /* Storage unavailable. */ }
        });
      });
    }

    initLanguageSwitcher();
    document.addEventListener('astro:page-load', initLanguageSwitcher);
  })();
</script>
