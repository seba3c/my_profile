---
import { site } from '../../data/site';
const year = new Date().getFullYear();
---

<footer class="mt-auto bg-background">
  <p class="text-sm text-footer-muted text-center lg:text-center">
    {site.hero.nickname} {year}
  </p>
  <p class="text-sm text-footer-muted text-center lg:text-center">
    Designed by{' '}
    <a href="https://juanaylola.com/" target="_blank" rel="noopener noreferrer" class="text-slate-light transition hover:text-slate-lightest">
      Juana &amp; Lola Digital
    </a>
  </p>
<div class="flex gap-6 text-sm"><a href={site.contact.x} target="_blank" rel="noreferrer">X ↗</a><a href={site.contact.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></div></footer>
