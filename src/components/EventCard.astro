---
import type { FeaturedEvent } from '../../data/site';
import { Icon } from 'astro-icon/components';

interface Props {
  event: FeaturedEvent;
}

const { event } = Astro.props;
---

<article class="scroll-stat panel-card group space-y-4 bg-white-soft/50">
  <header>
    <h3 class="text-2xl font-semibold text-slate">
      {event.name}
    </h3>
    {event.location && event.date && (
      <p class="mt-1 font-mono text-sm text-accent">
        {event.location} — {event.date}
      </p>
    )}
  </header>

  <p class="body-copy">{event.description}</p>

  {event.role && (
    <ul>
    <li>
      <span class="text-xs uppercase tracking-wider text-accent">Role</span>
      <span class="mt-1.5 text-sm text-slate-light">{event.role}</span>
    </li>
    </ul>
  )}

  <div class="flex flex-wrap items-center gap-3">
    {event.eventLink && (
      <a
        href={event.eventLink}
        target="_blank"
        rel="noreferrer"
        class="pill-link"
      >
        Event site
        <Icon name="ph:arrow-square-out" class="h-3 w-3" />
      </a>
    )}
    {event.activityLink && (
      <a
        href={event.activityLink}
        target="_blank"
        rel="noreferrer"
        class="pill-link"
      >
        Activity
        <Icon name="ph:arrow-square-out" class="h-3 w-3" />
      </a>
    )}
  </div>
</article>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>
