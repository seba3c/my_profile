---
import type { FeaturedProject } from '../../data/site';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
---

  <article class="scroll-stat panel-card group space-y-4 bg-white-soft/50">
  <header>
    <h3 class="text-2xl font-semibold text-slate">
      {project.title}
    </h3>
    {project.period && <p class="mt-1 font-mono text-sm text-accent">{project.period}</p>}
  </header>

  <p class="body-copy">{project.summary}</p>

  <ul>
    {project.role && (
      <li>
        <span class="text-xs uppercase tracking-wider text-accent">Role</span>
        <span class="mt-1.5 text-sm text-slate-light">{project.role}</span>
      </li>
    )}

    <li>
      <span class="text-xs uppercase tracking-wider text-accent">Tech stack</span>
      <span class="mt-1.5 text-sm text-slate-light">
        {project.techStack.join(', ')}
      </span>
    </li>
  </ul>

  {project.link && (
    <div>
      <a
        href={project.link}
        target="_blank"
        rel="noreferrer"
        class="pill-link"
      >
        View →
      </a>
    </div>
  )}
</article>
