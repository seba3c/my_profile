---
import type { FeaturedProject } from '../../data/site';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
---

<article class="project-card">
  <header class="project-heading">
    <h3>{project.title}</h3>
    {project.period && <p class="project-period">{project.period}</p>}
  </header>

  <a
    href={project.link}
    target="_blank"
    rel="noreferrer"
    aria-label={`View ${project.title} (opens in a new tab)`}
    class="project-preview"
  >
    <img
      src={project.preview.src}
      alt={project.preview.alt}
      width={project.preview.width}
      height={project.preview.height}
      loading="lazy"
      decoding="async"
    />
  </a>

  <p class="project-summary body-copy">{project.summary}</p>

  <div class="project-details">
    <dl>
      {project.role && <div><dt>Role</dt><dd>{project.role}</dd></div>}
      {project.techStack.length > 0 && <div><dt>Tech stack</dt><dd>{project.techStack.join(', ')}</dd></div>}
    </dl>
    <a href={project.link} target="_blank" rel="noreferrer" class="pill-link">View →</a>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    width: 100%;
    max-width: 64rem;
    grid-template-columns: 240px minmax(0, 1fr);
    grid-template-areas: 'preview heading' 'preview summary' 'preview details';
    align-items: start;
    gap: 16px 24px;
    padding: 28px 0 32px;
    border-bottom: 1px solid var(--color-navy-lighter);
  }

  .project-heading { grid-area: heading; min-width: 0; }
  .project-heading h3 { font-size: 24px; font-weight: 400; overflow-wrap: anywhere; }
  .project-period { margin-top: 8px; font: 13px var(--font-mono); color: var(--color-accent); }
  .project-summary { grid-area: summary; min-width: 0; max-width: 68ch; }
  .project-details { grid-area: details; min-width: 0; }
  .project-details dl { display: flex; flex-wrap: wrap; gap: 16px 32px; margin-bottom: 20px; }
  .project-details dl > div { min-width: 0; }
  .project-details dt { margin-bottom: 6px; font: 13px var(--font-mono); color: var(--color-accent); }
  .project-details dd { font-size: 14px; line-height: 1.7; color: var(--color-subtext); overflow-wrap: anywhere; }
  .project-preview {
    grid-area: preview;
    display: block;
    width: 240px;
    max-width: 100%;
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid var(--color-navy-lighter);
    border-radius: 4px;
  }
  .project-preview img { display: block; width: 100%; height: auto; }
  .project-preview:hover { border-color: var(--color-subtext); }
  .project-preview:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }

  @media (max-width: 767px) {
    .project-card {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'heading' 'preview' 'summary' 'details';
      gap: 16px;
    }
  }
</style>
