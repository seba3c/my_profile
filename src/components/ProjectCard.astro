---
import type { FeaturedProject } from '../../data/site';

interface Props {
  project: FeaturedProject;
}

const { project } = Astro.props;
---

  <article class="scroll-stat panel-card group space-y-4 bg-white-soft/50">
  <header>
    <h3 class="text-2xl font-semibold text-slate">
      {project.title}
    </h3>
    {project.period && <p class="mt-1 font-mono text-sm text-accent">{project.period}</p>}
  </header>

  <p class="body-copy">{project.summary}</p>

  {project.role && (
    <div>
      <span class="text-xs uppercase tracking-wider text-accent">Role</span>
      <p class="mt-1.5 text-sm text-slate-light">{project.role}</p>
    </div>
  )}

  <div>
    <span class="text-xs uppercase tracking-wider text-accent">Tech stack</span>
    <p class="mt-1.5 text-sm text-slate-light">
      {project.techStack.join(', ')}
    </p>
  </div>

  {project.link && (
    <div>
      <a
        href={project.link}
        target="_blank"
        rel="noreferrer"
        class="text-sm text-accent transition hover:text-slate-light hover:underline"
      >
        View project →
      </a>
    </div>
  )}
</article>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>
