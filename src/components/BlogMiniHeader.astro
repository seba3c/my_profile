---
import { Image } from 'astro:assets';
import { site } from '@data/site';
import { resolveNavHref } from '../lib/nav';
---

<a
  href={resolveNavHref('/')}
  class="group mb-8 flex items-center gap-3"
  data-astro-prefetch
>
  <div class="h-20 w-20 shrink-0 overflow-hidden rounded-full border border-accent">
    <Image
      src={site.hero.avatarSrc}
      alt={site.hero.avatarAlt}
      class="h-full w-full object-cover"
      loading="eager"
      width={160}
      height={160}
    />
  </div>
  <div class="flex min-w-0 flex-col leading-tight">
    <span class="text-lg font-semibold text-white transition group-hover:text-accent">
      {site.hero.name}
    </span>
    <span class="text-sm font-medium text-slate-light">{site.hero.role}</span>
    <span class="body-copy text-xs">{site.hero.tagline}</span>
  </div>
</a>
