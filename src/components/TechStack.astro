---
import TerminalReveal from './TerminalReveal.astro';
import { Icon } from 'astro-icon/components';
import { site } from '@data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const copy = site.techStackExplorer;
const total = site.techStack.reduce((count, group) => count + group.items.length, 0);
---

<section id="tech-stack" class:list={['toolkit-section', className]} aria-labelledby="tech-stack-heading">
  <TerminalReveal title={copy.title} headingId="tech-stack-heading">
  <p class="toolkit-description">{copy.description}</p>
  <package-explorer data-package-label={copy.packageLabel} data-directory-label={copy.directoryLabel}>
    <div class="explorer-toolbar">
      <span class="explorer-path"><Icon name="ph:folder-open" aria-hidden="true" />{copy.path}</span>
      <span class="explorer-total" aria-hidden="true">{total} {copy.packageLabel}</span>
    </div>
    <div class="explorer-search" hidden>
      <label for="toolkit-search"><span aria-hidden="true">$ grep -i</span><span class="sr-only">{copy.searchLabel}</span></label>
      <input id="toolkit-search" type="search" placeholder={copy.searchPlaceholder} autocomplete="off" spellcheck="false" aria-controls="toolkit-directories" />
      <button type="button" data-clear disabled aria-label={copy.clearLabel}><Icon name="ph:x" aria-hidden="true" /></button>
    </div>
    <div id="toolkit-directories" class="explorer-directories">
      {site.techStack.map(group => (
        <details class="explorer-directory" data-category={group.category} open>
          <summary>
            <Icon name="ph:caret-right" class="directory-caret" aria-hidden="true" />
            <Icon name="ph:folder" class="directory-folder" aria-hidden="true" />
            <span class="directory-name">{group.category}</span>
            <span class="directory-count" aria-hidden="true">{group.items.length}</span>
          </summary>
          <ul class="directory-packages" aria-label={group.category}>
            {group.items.map(tech => <li data-package={tech}><span class="package-branch" aria-hidden="true"></span><span data-package-name>{tech}</span></li>)}
          </ul>
        </details>
      ))}
    </div>
    <div class="explorer-empty" hidden>
      <Icon name="ph:magnifying-glass" aria-hidden="true" />
      <h3>{copy.emptyTitle}</h3>
      <p>{copy.emptyDescription}</p>
      <button type="button" data-reset>{copy.clearLabel}</button>
    </div>
    <div class="explorer-footer"><span class="explorer-prompt" aria-hidden="true">$</span><p data-status role="status" aria-live="polite" aria-atomic="true">{total} {copy.packageLabel} · {site.techStack.length} {copy.directoryLabel}</p></div>
  </package-explorer>
</TerminalReveal>
</section>

<script>
  class PackageExplorer extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      this.cleanup?.();
      const controller = new AbortController();
      const { signal } = controller;
      const input = this.querySelector<HTMLInputElement>('input')!;
      const clear = this.querySelector<HTMLButtonElement>('[data-clear]')!;
      const status = this.querySelector<HTMLElement>('[data-status]')!;
      const empty = this.querySelector<HTMLElement>('.explorer-empty')!;
      const groups = Array.from(this.querySelectorAll<HTMLDetailsElement>('details'));
      let savedStates: boolean[] | undefined;
      let announceTimer: ReturnType<typeof setTimeout> | undefined;
      const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

      const filter = () => {
        const query = normalize(input.value.trim());
        if (query && !savedStates) savedStates = groups.map(group => group.open);
        let packages = 0;
        let directories = 0;
        groups.forEach((group, index) => {
          const categoryMatches = Boolean(query && normalize(group.dataset.category || '').includes(query));
          let matches = 0;
          group.querySelectorAll<HTMLElement>('[data-package]').forEach(item => {
            const name = item.dataset.package || '';
            const visible = !query || categoryMatches || normalize(name).includes(query);
            item.hidden = !visible;
            const label = item.querySelector<HTMLElement>('[data-package-name]')!;
            label.textContent = name;
            if (visible) matches++;
          });
          group.hidden = matches === 0;
          group.querySelector<HTMLElement>('.directory-count')!.textContent = String(matches);
          if (query && matches) group.open = true;
          else if (!query && savedStates) group.open = savedStates[index];
          if (matches) directories++;
          packages += matches;
        });
        if (!query) savedStates = undefined;
        empty.hidden = packages !== 0;
        clear.disabled = !input.value;
        clearTimeout(announceTimer);
        announceTimer = setTimeout(() => {
          status.textContent = `${packages} ${this.dataset.packageLabel} · ${directories} ${this.dataset.directoryLabel}`;
        }, 150);
      };
      const reset = () => { input.value = ''; filter(); input.focus(); };
      input.addEventListener('input', filter, { signal });
      input.addEventListener('keydown', event => {
        if (event.key === 'Escape') { event.preventDefault(); reset(); }
        if (event.key === 'ArrowDown') {
          const first = groups.find(group => !group.hidden)?.querySelector('summary');
          if (first) { event.preventDefault(); first.focus(); }
        }
      }, { signal });
      this.addEventListener('keydown', event => {
        if (!(event.target instanceof HTMLElement) || event.target.tagName !== 'SUMMARY') return;
        if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
        const summaries = groups.filter(group => !group.hidden).map(group => group.querySelector('summary')!);
        const index = summaries.indexOf(event.target);
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? summaries.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + summaries.length) % summaries.length;
        event.preventDefault();
        summaries[next]?.focus();
      }, { signal });
      clear.addEventListener('click', reset, { signal });
      this.querySelector('[data-reset]')!.addEventListener('click', reset, { signal });
      this.querySelector<HTMLElement>('.explorer-search')!.hidden = false;
      this.cleanup = () => { controller.abort(); clearTimeout(announceTimer); };
    }

    disconnectedCallback() { this.cleanup?.(); }
  }

  if (!customElements.get('package-explorer')) customElements.define('package-explorer', PackageExplorer);
</script>

<style>
  .toolkit-description { margin: -12px 0 28px; color: var(--color-subtext); font-size: 14px; line-height: 1.7; }
  package-explorer { display: block; overflow: hidden; border: 1px solid var(--color-navy-lighter); border-radius: 4px; background: var(--color-navy-light); font-family: var(--font-mono); }
  .explorer-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 24px; border-bottom: 1px solid var(--color-navy-lighter); }
  .explorer-path { display: flex; align-items: center; gap: 10px; color: var(--color-accent); font-size: 13px; }
  .explorer-path :global(svg), .explorer-search :global(svg) { width: 18px; height: 18px; }
  .explorer-total { color: var(--color-subtext); font-size: 13px; }
  .explorer-search { display: flex; align-items: center; gap: 16px; padding: 14px 24px; border-bottom: 1px solid var(--color-navy-lighter); background: var(--color-background); }
  .explorer-search label { flex-shrink: 0; font-size: 13px; color: var(--color-terminal-amber); }
  .explorer-search input { width: 100%; min-width: 0; padding: 10px 0; background: transparent; color: var(--color-maintext); font: 14px var(--font-mono); }
  .explorer-search input::placeholder { color: var(--color-subtext); opacity: 1; }
  .explorer-search button { display: grid; place-items: center; width: 44px; min-width: 44px; height: 44px; color: var(--color-accent); cursor: pointer; }
  .explorer-search button:disabled { color: var(--color-subtext); opacity: .5; cursor: default; }
  .explorer-directory { padding: 0 24px; }
  .explorer-directory + .explorer-directory { border-top: 1px solid var(--color-navy-lighter); }
  .explorer-directory summary { display: flex; align-items: center; gap: 12px; padding: 22px 0; list-style: none; color: var(--color-maintext); font: 14px var(--font-mono); }
  .explorer-directory summary::-webkit-details-marker { display: none; }
  .directory-caret { width: 14px; height: 14px; flex-shrink: 0; transition: transform 200ms cubic-bezier(.16,1,.3,1); color: var(--color-subtext); }
  .explorer-directory[open] .directory-caret { transform: rotate(90deg); }
  .directory-folder { width: 18px; height: 18px; flex-shrink: 0; color: var(--color-terminal-amber); }
  .directory-name { overflow-wrap: anywhere; }
  .directory-count { margin-left: auto; color: var(--color-subtext); font-size: 13px; font-variant-numeric: tabular-nums; }
  .directory-packages { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0 28px; padding: 0 0 24px 26px; }
  .directory-packages li { display: flex; align-items: center; gap: 12px; min-height: 42px; font-size: 13px; color: var(--color-textrain); overflow-wrap: anywhere; }
  .package-branch { width: 12px; height: 12px; border-bottom: 1px solid var(--color-navy-lighter); border-left: 1px solid var(--color-navy-lighter); flex-shrink: 0; align-self: flex-start; margin-top: 9px; }
  .explorer-directory[open] .directory-packages { animation: directory-open 220ms cubic-bezier(.16,1,.3,1); }
  .explorer-footer { display: flex; align-items: baseline; gap: 12px; padding: 16px 24px; border-top: 1px solid var(--color-navy-lighter); color: var(--color-subtext); font-size: 13px; }
  .explorer-prompt { color: var(--color-accent); }
  .explorer-empty { padding: 40px 24px; text-align: center; }
  .explorer-empty :global(svg) { width: 28px; height: 28px; margin: 0 auto 16px; color: var(--color-terminal-amber); }
  .explorer-empty h3 { font-size: 17px; margin-bottom: 12px; }
  .explorer-empty p { font: 14px/1.7 var(--font-sans); color: var(--color-subtext); }
  .explorer-empty button { margin-top: 20px; padding: 12px; color: var(--color-accent); text-decoration: underline; text-underline-offset: 5px; cursor: pointer; }
  @keyframes directory-open { from { clip-path: inset(0 0 100%); } to { clip-path: inset(0); } }
  @media (max-width: 767px) { .directory-packages { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 16px; } }
  @media (max-width: 479px) { .explorer-toolbar, .explorer-search, .explorer-footer { padding-left: 16px; padding-right: 16px; } .explorer-directory { padding: 0 16px; } .explorer-total { display: none; } .explorer-search { gap: 10px; } .explorer-search label { font-size: 13px; } .explorer-search input { font-size: 17px; } .directory-packages { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .directory-caret { transition: none; } .explorer-directory[open] .directory-packages { animation: none; } }
</style>
