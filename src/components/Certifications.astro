---
import { site } from '../../data/site';
import { Icon } from 'astro-icon/components';
---

<section
  id="certifications"
  class="mb-16 scroll-mt-24 lg:mb-24 lg:scroll-mt-8"
  aria-labelledby="certifications-heading"
>
  <h2 id="certifications-heading" class="section-heading">Certifications</h2>

  {site.certifications.length < 1 ? (
    <p class="body-copy text-slate-light">{site.certificationsEmptyText}</p>
  ) : (
    <div class="space-y-8">
      {site.certifications.map((cert) => (
        <article class="scroll-stat panel-card group space-y-4 bg-white-soft/50">
          <header>
            <h4 class="text-2xl font-semibold text-slate">{cert.name}</h4>
            <span class="mt-1.5 text-md text-slate-light">{cert.issuer}</span>
          </header>

          <ul>
            <li>
              <span class="text-xs uppercase tracking-wider text-accent">Issued</span>
              <span class="mt-1.5 text-sm text-slate-light">{cert.date}</span>
            </li>
            <li>
              <span class="text-xs uppercase tracking-wider text-accent">Credential ID</span>
              <span class="mt-1.5 text-sm text-slate-light">{cert.credentialId}</span>
            </li>
          </ul>

          {cert.credentialLink && (
            <div>
              <a
                href={cert.credentialLink}
                target="_blank"
                rel="noreferrer"
                class="pill-link"
              >
                Show credential
                <Icon name="ph:arrow-square-out" class="h-3 w-3" />
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  )}
</section>
