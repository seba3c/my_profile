---
import { site } from '../../data/site';
import { Icon } from 'astro-icon/components';
---

<section
  id="certifications"
  class="mb-16 scroll-mt-24 lg:mb-24 lg:scroll-mt-8"
  aria-labelledby="certifications-heading"
>
  <h2 id="certifications-heading" class="section-heading">Certifications</h2>

  {site.certifications.length < 1 ? (
    <p class="body-copy text-slate-light">{site.certificationsEmptyText}</p>
  ) : (
    <div class="space-y-8">
      {site.certifications.map((cert) => (
        <article class="scroll-stat panel-card group space-y-4 bg-white-soft/50">
          <header>
            <h4 class="text-2xl font-semibold text-slate">{cert.name}</h4>
            <span class="mt-1.5 text-md text-slate-light">{cert.issuer}</span>
          </header>

          <ul>
            <li>
              <span class="text-xs uppercase tracking-wider text-accent">Issued</span>
              <span class="mt-1.5 text-sm text-slate-light">{cert.date}</span>
            </li>
            <li>
              <span class="text-xs uppercase tracking-wider text-accent">Credential ID</span>
              <span class="mt-1.5 text-sm text-slate-light">{cert.credentialId}</span>
            </li>
          </ul>

          {cert.credentialLink && (
            <div>
              <a
                href={cert.credentialLink}
                target="_blank"
                rel="noreferrer"
                class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-medium text-accent transition-all duration-200 ease-out hover:bg-accent/20 hover:scale-105"
              >
                Show credential
                <Icon name="ph:arrow-square-out" class="h-3 w-3" />
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  )}
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<script>
  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const index = Array.from(cards).indexOf(entry.target);
          setTimeout(() => {
            entry.target.classList.add('reveal');
          }, (index % 3) * 150); 
          
          observer.unobserve(entry.target);
        }
      });
    }, {
      threshold: 0.15,
      rootMargin: '0px 0px -10px 0px'
    });

    cards.forEach(card => observer.observe(card));
  }

  revealCards();
  
  document.addEventListener('astro:after-swap', revealCards);
</script>
