---
import TerminalReveal from './TerminalReveal.astro';
import type { FeaturedProject } from "../../data/site";
import ProjectCard from "./ProjectCard.astro";
import { site } from '@data/site';
import { resolveNavHref } from '../lib/nav';
import { Icon } from "astro-icon/components";

interface Props {
  projects: readonly FeaturedProject[];
}

const { projects } = Astro.props;
const archiveHref = resolveNavHref('/projects');
---

<section
  id="featured-projects"
  class="mb-16 scroll-mt-24 lg:mb-24 lg:scroll-mt-8"
  aria-labelledby="projects-heading"
>
  <TerminalReveal title="Featured Projects" headingId="projects-heading">
  <div class="space-y-8">
    {
      projects.map((project) => (
        <ProjectCard project={project} />
      ))
    }
  </div>
  <p class="archive-access">
    <a
      href={archiveHref}
      class="archive-link"
      data-astro-prefetch
    >
      <span>{site.archiveNavigation.projects}</span>
      <Icon
        name="ph:arrow-right"
        class="h-4 w-4 shrink-0"
      />
    </a>
  </p>
</TerminalReveal>
</section>
